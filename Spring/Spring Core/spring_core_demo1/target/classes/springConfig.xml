<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    
    <!-- bean -> object creation (IOC container) -->
    
    <bean name="tataBean" class="com.sprk.cars.Tata" lazy-init="true"></bean>
    <bean name="kiaBean" class="com.sprk.cars.Kia" lazy-init="true"></bean>
    <bean name="bmwBean" class="com.sprk.cars.BMW" lazy-init="true"></bean>
    
    	<!-- Dependency Injection
    	Constructor Injection -->
    <!-- Showroom Bean (Need Car Object) 
    <bean name="showRoomBean" class="com.sprk.showroom.CarShowroom">
    	<constructor-arg name="iCar" ref="tataBean"></constructor-arg>
    </bean> -->
    
    	<!-- Dependency Injection -->
    	<!-- Setter Injection -->
    <!-- Showroom Bean (Need Car Object) -->
    <bean name="showRoomBean" class="com.sprk.showroom.CarShowroom">
    	<property name="iCar" ref="bmwBean"></property>
    </bean>

	
</beans>